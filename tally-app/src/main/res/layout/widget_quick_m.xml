<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2「快速记账」（WG-Q2）：八个槽位排两行四列。
     一行八个在 250dp 宽里每格只剩 31dp，手指点不准，所以不那样排。
     分类不足八个时空着的槽位整块隐藏，不拿固定分类凑数。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/widget_dot" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/widget_quick_title"
            android:textColor="@color/widget_brand"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/wqm_tile_0"
            style="@style/WidgetQuickTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wqm_icon_0"
                style="@style/WidgetQuickIcon"
                android:src="@drawable/ic_food" />

            <TextView
                android:id="@+id/wqm_name_0"
                style="@style/WidgetQuickName" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wqm_tile_1"
            style="@style/WidgetQuickTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wqm_icon_1"
                style="@style/WidgetQuickIcon"
                android:src="@drawable/ic_bus" />

            <TextView
                android:id="@+id/wqm_name_1"
                style="@style/WidgetQuickName" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wqm_tile_2"
            style="@style/WidgetQuickTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wqm_icon_2"
                style="@style/WidgetQuickIcon"
                android:src="@drawable/ic_bag" />

            <TextView
                android:id="@+id/wqm_name_2"
                style="@style/WidgetQuickName" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wqm_tile_3"
            style="@style/WidgetQuickTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wqm_icon_3"
                style="@style/WidgetQuickIcon"
                android:src="@drawable/ic_snack" />

            <TextView
                android:id="@+id/wqm_name_3"
                style="@style/WidgetQuickName" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/wqm_tile_4"
            style="@style/WidgetQuickTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wqm_icon_4"
                style="@style/WidgetQuickIcon"
                android:src="@drawable/ic_game" />

            <TextView
                android:id="@+id/wqm_name_4"
                style="@style/WidgetQuickName" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wqm_tile_5"
            style="@style/WidgetQuickTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wqm_icon_5"
                style="@style/WidgetQuickIcon"
                android:src="@drawable/ic_med" />

            <TextView
                android:id="@+id/wqm_name_5"
                style="@style/WidgetQuickName" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wqm_tile_6"
            style="@style/WidgetQuickTile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/wqm_icon_6"
                style="@style/WidgetQuickIcon"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/wqm_name_6"
                style="@style/WidgetQuickName" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wqm_tile_add"
            style="@style/WidgetQuickTileBrand"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1">

            <ImageView
                style="@style/WidgetQuickIcon"
                android:src="@drawable/widget_plus_glyph" />

            <TextView
                style="@style/WidgetQuickNameBrand"
                android:text="@string/widget_add_bill" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_failure_hint"
        android:textColor="@color/widget_ink3"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
