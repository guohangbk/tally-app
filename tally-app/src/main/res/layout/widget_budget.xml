<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2「预算 · 圆环占比」（WG-07）：环 = 已用 / 预算额，中心写百分比，下面一整行只一个结论数。
     环用系统圆形 ProgressBar + ring drawable（轨道 + 按 level 扫出的进度扇区），无预算时换成 setup 那一行。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_dot" />

        <TextView
            android:id="@+id/widget_ring_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/widget_budget_ring_title"
            android:textColor="@color/widget_brand"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink2"
            android:textSize="9.5sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_budget_ring_wrap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ProgressBar
            android:id="@+id/widget_budget_ring_green"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@null"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_budget_ring_green"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widget_budget_ring_gold"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@null"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_budget_ring_gold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/widget_budget_ring_expense"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:background="@null"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_budget_ring_expense"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_budget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="20sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/widget_budget_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="serif"
        android:fontFeatureSettings="'tnum'"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_budget_setup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_budget_setup"
        android:textColor="@color/widget_ink3"
        android:textSize="10sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_failure_hint"
        android:textColor="@color/widget_ink3"
        android:textSize="7.5sp"
        android:visibility="gone" />
</LinearLayout>
