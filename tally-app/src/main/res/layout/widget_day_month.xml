<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2「当日 + 当月」（WG-08）：顶栏日期 + 今日支出主数字 + 本月支出副行。
     上下各留一根 flex 让两块金额在标题与底部之间居中，不再挤在上半屏、下半大片空白；字号整体调大。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/widget_dot" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/widget_ink3"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 触摸区 40dp、可见底板仍是 26dp 居中：＋ 贴着卡片右上角，命中区只有 26dp 时
             点偏几 dp 就落到整卡的「→ 统计」上，看着像加号按了没反应（走查 bug）。
             不用负 margin 撑大——父容器 clipChildren 会把超出部分的触摸也裁掉，那是假命中区。 -->
        <FrameLayout
            android:id="@+id/widget_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_plus_bg"
                android:contentDescription="@string/widget_add_bill"
                android:padding="6dp"
                android:src="@drawable/widget_plus_glyph" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/widget_today_expense_label"
        android:textColor="@color/widget_ink3"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_today_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:alpha="0.55"
            android:includeFontPadding="false"
            android:text="@string/widget_currency"
            android:textColor="@color/widget_expense"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_today_int"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_expense"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/widget_today_dec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_expense"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_month_expense_label"
            android:textColor="@color/widget_ink3"
            android:textSize="10sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_month_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="19sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:text="@string/widget_failure_hint"
        android:textColor="@color/widget_ink3"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
