<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2「收支速览」（WG-S1）：今日支出是唯一主角，本月收支两行贴底。
     顶栏已经写了「今日」，大字下面不再重复「今日支出」；本月两行的标签自带「本月」，
     也不单占一行——2×2 的净高只够这么多行，多一行字就会把本月收入顶出可视区。
     中间留一根 flex：多出来的高度全给大字与两行之间，两行始终贴底。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/widget_dot" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:text="@string/widget_today_label"
            android:textColor="@color/widget_brand"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 触摸区 36dp、可见底板 26dp：加号只有 26dp 命中区时点偏几 dp 就落到整卡上，
             看着像按了没反应（当日当月那枚的走查结论，这里照搬并把外壳收窄，给大字让高度）。 -->
        <FrameLayout
            android:id="@+id/wfs_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_plus_bg"
                android:contentDescription="@string/widget_add_bill"
                android:padding="6dp"
                android:src="@drawable/widget_plus_glyph" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wfs_today_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3dp"
            android:alpha="0.55"
            android:includeFontPadding="false"
            android:text="@string/widget_currency"
            android:textColor="@color/widget_expense"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/wfs_today_int"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_expense"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/wfs_today_dec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_expense"
            android:textSize="15sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_month_expense_label"
            android:textColor="@color/widget_ink3"
            android:textSize="10sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wfs_month_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_expense"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/widget_month_income_label"
            android:textColor="@color/widget_ink3"
            android:textSize="10sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/wfs_month_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:fontFeatureSettings="'tnum'"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_income"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_failure_hint"
        android:textColor="@color/widget_ink3"
        android:textSize="9sp"
        android:visibility="gone" />
</LinearLayout>
