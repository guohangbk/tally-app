<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 仅用于用户自己配置的 WebDAV 与 AI 服务商；没有第三方统计/广告 SDK。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 语音速记用系统识别引擎，音频不出设备；拒绝授权时页面自动降级为文字输入。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      四类提醒。权限只加了这一类：不做应用锁（系统级已覆盖），
      所以也不申请 USE_BIOMETRIC。授权只在通知设置页要一次，被拒后不再弹系统框。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 的包可见性限制：不看得到识别服务就会误判成「本机没有引擎」。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".TallyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tally">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 截图记账入口之一：相册/文件里把支付截图「分享」过来。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- 长按图标的两条静态快捷方式：记一笔、添加小部件。 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 桌面组件（WG-06）：近七日只读，点了落回 MainActivity 走 pendingLink。 -->
        <receiver
            android:name=".ui.widget.SevenDayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_seven_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_seven_day" />
        </receiver>

        <!-- 三期新增七枚（docs/v3 桌面组件板）：与近七日并存，各占独立 provider。
             同样只读，点击一律落回 MainActivity 走现成深链。 -->
        <receiver
            android:name=".ui.widget.FlowSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_flow_s_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_flow_s" />
        </receiver>
        <receiver
            android:name=".ui.widget.FlowWideWidgetProvider"
            android:exported="true"
            android:label="@string/widget_flow_m_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_flow_m" />
        </receiver>
        <receiver
            android:name=".ui.widget.QuickSmallWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quick_s_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_s" />
        </receiver>
        <receiver
            android:name=".ui.widget.QuickWideWidgetProvider"
            android:exported="true"
            android:label="@string/widget_quick_m_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_m" />
        </receiver>
        <receiver
            android:name=".ui.widget.BudgetRingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_budget_ring_v2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget_v2" />
        </receiver>
        <receiver
            android:name=".ui.widget.RhythmWidgetProvider"
            android:exported="true"
            android:label="@string/widget_rhythm_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rhythm" />
        </receiver>
        <receiver
            android:name=".ui.widget.StreakWidgetProvider"
            android:exported="true"
            android:label="@string/widget_streak_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

